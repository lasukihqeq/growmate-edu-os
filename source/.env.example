# WILDER 潜能星探 - 环境变量配置
# 复制此文件为 .env.local 并填入实际值
#
# ⚠️  安全警告：VITE_ 前缀的环境变量会被 Vite 内联到前端 JS 包中，
# 任何访问网站的用户都能在浏览器开发者工具中看到这些值。
# 请勿在前端变量中存放真实的 API Key 或其他敏感凭证！
# 生产环境应通过后端代理转发 API 请求，而非前端直连。

# 管理员令牌 (必填)
# 在管理后台设置后会自动保存到 localStorage
VITE_ADMIN_TOKEN=

# API 基础 URL (可选，默认已在代码中配置)
# VITE_API_BASE=http://assessment.hykx.com.cn/api

# OpenAI API Key (用于 AI 对话功能，可选)
# VITE_OPENAI_API_KEY=sk-xxx

# MiniMax API Key (用于 AI 报告生成，可选)
# VITE_MINIMAX_API_KEY=xxx

# DeepSeek API Key (用于 AI 深度报告生成，推荐)
# VITE_DEEPSEEK_API_KEY=sk-xxx
